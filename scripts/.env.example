# 이 파일을 복사해 scripts\.env를 만들고 UE5 담당이 채웁니다.
# 비워 두면 그 단계는 건너뜁니다.

# 시그널링 서버 실행 파일 (예: D:\demo\SignallingWebServer\platform_scripts\cmd\start.bat)
SIGNALING_CMD=

# UE5 패키징 빌드 실행 파일과 인자
# -CrackApiUrl(점검 스크린샷을 보낼 서버 주소)을 빼면 스크립트가 http://127.0.0.1:API_PORT 를 자동으로 붙입니다.
UE_EXE=
UE_ARGS=-PixelStreamingURL=ws://127.0.0.1:8888 -CrackApiUrl=http://127.0.0.1:8000 -ResX=1920 -ResY=1080 -Windowed

# API 주소 (터널과 상태 확인에 사용)
API_PORT=8000
