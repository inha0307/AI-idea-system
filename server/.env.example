# 이 파일을 복사해 .env를 만듭니다: Copy-Item .env.example .env
DATABASE_URL=postgresql://app:app@localhost:5432/crack

# fake = 고정된 균열 1개를 돌려줌 (M2용) / yolo = MODEL_PATH의 모델로 실제 탐지
DETECTOR=fake
MODEL_PATH=./models/best.pt
DEVICE=cpu
CONF_THRESHOLD=0.25

STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000,https://프로젝트명.vercel.app

# 관리자 로그인 (비밀값, Git 금지). 비어 있으면 관리자 로그인 불가 → 점검 시작 불가
# AUTH_SECRET은 길고 무작위인 문자열 (비우면 서버를 재시작할 때마다 다시 로그인)
ADMIN_PASSWORD=
AUTH_SECRET=
ADMIN_TOKEN_HOURS=12

# 같은 균열로 묶는 반경 (cm). 이 안에 이미 관측된 균열이 있으면 같은 trackId
TRACK_MATCH_CM=50

# 기상청 단기예보 조회서비스 키 (공공데이터포털 → 마이페이지 → 일반 인증키 Decoding)
# 비밀값이므로 .env에만 넣고 Git에 올리지 않습니다 (규칙 8). 비어 있으면 /weather가 503
KMA_SERVICE_KEY=
WEATHER_CACHE_SEC=600

# 평균 폭(mm) 기준. 임시값이며 AI 담당이 확정합니다.
SEVERITY_CAUTION_MM=0.3
SEVERITY_DANGER_MM=1.0
